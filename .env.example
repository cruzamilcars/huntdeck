# ---------------------------------------------------------------------------
# OSINT MCP Hub environment template.
# This file is documentation. Copy the relevant variables to the runtime
# files each app actually reads:
#   - API:  apps/api/.env      (read by pydantic-settings from the API CWD)
#   - Web:  apps/web/.env.local (NEXT_PUBLIC_* are inlined at build time)
# Never commit those files; they are gitignored.
# ---------------------------------------------------------------------------

# --- Supabase (optional for local dev; required for auth + persistence) ---
# Web app (NEXT_PUBLIC_*) and API share the same project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- API ---
# URL the web app uses to reach the FastAPI backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Comma-separated list of allowed CORS origins for the API.
API_CORS_ORIGINS=http://localhost:3000

# --- Quota ---
# Free investigations per user/organization per day (default: 10).
DAILY_FREE_QUOTA=10

# --- Rate limiting ---
# Max API requests per IP per minute (default: 60).
RATE_LIMIT_PER_MINUTE=60

# --- MCP provider keys ---
# Used only for platform-funded quota. BYOK keys are stored in Supabase Vault,
# never in this file or in public tables.
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=
ABUSEIPDB_API_KEY=
# urlscan.io API key (replaces Firecrawl for URL/DOMAIN web-harvesting).
URLSCAN_API_KEY=

# --- Durable local store ---
# SQLite path used by the API when Supabase persistence is not configured.
DATABASE_PATH=data/huntdeck.db